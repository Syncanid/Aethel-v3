system:
  log_level: "DEBUG"

  # IO 连接设置 (预留)
  onebot_url: "ws://127.0.0.1:3001"
  onebot_token: ""
  bot_self_id: 12345678

llm:
  # 兼容 OpenAI 格式的 API 设置
  api_base_url: "https://api.openai.com/v1"
  api_key: "sk-YourKeyHere"
  model_name: "gpt-4o"
  model_context: 32767
  embedding_model_name: "text-embedding-ada-002"

  prompt_file: "data/prompts/system_prompt.md"
  role_card: "data/prompts/role_card.yaml"

proxy:
  enabled: false
  enabled_llm: false
  http: ""
  https: ""

mcp_servers:
  # MCP 服务器配置示例 (后续阶段使用)
  # filesystem:
  #   command: "npx"
  #   args: ["-y", "@modelcontextprotocol/server-filesystem", "./data"]

searxng_base_url: "http://127.0.0.1:8080"